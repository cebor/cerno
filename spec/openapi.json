{
  "openapi": "3.1.0",
  "info": {
    "title": "cerno",
    "description": "Noul, Choice and Score against a locally hosted model. Each question is one forward pass: the answer is read from the probability distribution over the first generated token.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.1"
  },
  "paths": {
    "/v1/models": {
      "get": {
        "tags": [
          "cerno"
        ],
        "summary": "The models this server will answer for.",
        "operationId": "models",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/systemone": {
      "post": {
        "tags": [
          "cerno"
        ],
        "summary": "Ask several questions about one state.",
        "description": "Every question is one forward pass, and they are independent, so they run concurrently up to\nthe configured limit rather than one after another.\n\nThe request succeeds or fails as a whole: if any question fails, the error names it and the\nanswers to the others are discarded. The same holds when the whole request, waiting for a\nfree slot included, outlasts the server's request timeout: that is a 504 `host_timeout`.",
        "operationId": "systemone",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemOneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOneResponse"
                }
              }
            }
          },
          "400": {
            "description": "the body is not a valid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "the request cannot be answered as written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "a failure inside cerno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "the model or its runtime failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "the host timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "noul",
              "raw_logprobs",
              "truncated",
              "truncated_labels",
              "label_mass",
              "type"
            ],
            "properties": {
              "label_mass": {
                "type": "number",
                "format": "double"
              },
              "noul": {
                "type": "number",
                "format": "double",
                "description": "Probability that the answer is yes, in `0.0..=1.0`."
              },
              "raw_logprobs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "format": "double"
                },
                "propertyNames": {
                  "type": "string"
                }
              },
              "truncated": {
                "type": "boolean"
              },
              "truncated_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "noul"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "choice",
              "index",
              "confidence",
              "probabilities",
              "raw_logprobs",
              "truncated",
              "truncated_labels",
              "label_mass",
              "type"
            ],
            "properties": {
              "choice": {
                "type": "string",
                "description": "The winning option, verbatim as it was supplied."
              },
              "confidence": {
                "type": "number",
                "format": "double"
              },
              "index": {
                "type": "integer",
                "description": "Its position in the request's `options`.",
                "minimum": 0
              },
              "label_mass": {
                "type": "number",
                "format": "double"
              },
              "probabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OptionProbability"
                },
                "description": "Every option with its probability, in request order."
              },
              "raw_logprobs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "format": "double"
                },
                "propertyNames": {
                  "type": "string"
                }
              },
              "truncated": {
                "type": "boolean"
              },
              "truncated_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "choice"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "score",
              "expected_score",
              "legend",
              "confidence",
              "probabilities",
              "raw_logprobs",
              "truncated",
              "truncated_labels",
              "label_mass",
              "type"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "format": "double"
              },
              "expected_score": {
                "type": "number",
                "format": "double",
                "description": "The probability-weighted mean level — often more useful than the argmax."
              },
              "label_mass": {
                "type": "number",
                "format": "double"
              },
              "legend": {
                "type": "string",
                "description": "The legend entry for `score`."
              },
              "probabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LevelProbability"
                }
              },
              "raw_logprobs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "format": "double"
                },
                "propertyNames": {
                  "type": "string"
                }
              },
              "score": {
                "type": "integer",
                "format": "int32",
                "description": "The most likely level, 1-based.",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              },
              "truncated_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "score"
                ]
              }
            }
          }
        ],
        "description": "A typed answer.\n\nEvery variant carries `raw_logprobs`, `truncated` and `truncated_labels` so a caller can redo\nthe normalisation itself — calibration is a convenience here, never a place where information\nis lost.\n\nA label in `truncated_labels` fell outside the host's reporting window, so its entry in\n`raw_logprobs` is the weakest reported logprob: an upper bound, not an observation.\n`truncated` is true exactly when that list is not empty.\n\n`label_mass` is how much of the model's first-token probability fell on the offered labels,\nin `0.0..=1.0`, counting only labels the host reported. The probabilities are normalised over\nthe labels alone, so they look just as decisive when the model was about to write something\nelse entirely and the letters were an afterthought at `-8`. Near 1 the model answered with a\nletter; well below it, the answer was read off tokens the model was not going to produce."
      },
      "Calibration": {
        "type": "object",
        "description": "Temperature scaling applied to label logits before the softmax.\n\n`1.0` leaves the model's raw distribution untouched. Values above 1 flatten it, which is the\nusual correction for instruct-tuned models that answer clear cases at a probability of 1.0.",
        "required": [
          "temperature"
        ],
        "properties": {
          "temperature": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ChoiceSpec": {
        "type": "object",
        "required": [
          "options"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": [
              "string",
              "null"
            ],
            "description": "What is being asked. Omit when the options speak for themselves."
          }
        },
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable failure reasons. Callers branch on these, not on `message`.",
        "enum": [
          "too_many_options",
          "too_many_questions",
          "invalid_request",
          "too_few_options",
          "invalid_levels",
          "empty_state",
          "empty_question",
          "duplicate_question_id",
          "empty_question_id",
          "duplicate_option",
          "no_questions",
          "unknown_model",
          "invalid_calibration",
          "no_label_matched",
          "host_unavailable",
          "host_timeout",
          "internal"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "question_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when exactly one question is at fault."
          }
        }
      },
      "LevelProbability": {
        "type": "object",
        "required": [
          "level",
          "legend",
          "probability"
        ],
        "properties": {
          "legend": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "probability": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "LevelSpec": {
        "oneOf": [
          {
            "type": "integer",
            "format": "int32",
            "description": "`\"levels\": 5` — the engine generates the legend (\"1\" through \"5\").\n\nWider than the range it may hold, so `\"levels\": 300` reaches validation and is refused as\n`invalid_levels` naming the bounds, rather than failing to match either variant of this\nuntagged enum with a message that names neither.",
            "minimum": 0
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`\"levels\": [\"gar nicht\", \"wenig\", ...]` — the strings become the legend."
          }
        ],
        "description": "A rubric given either as a plain count or as the text of each level."
      },
      "ModelInfo": {
        "type": "object",
        "required": [
          "alias",
          "model",
          "calibration"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "description": "The name callers pass as `model`."
          },
          "calibration": {
            "$ref": "#/components/schemas/Calibration"
          },
          "model": {
            "type": "string",
            "description": "The host-level model this resolves to."
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "required": [
          "models",
          "default"
        ],
        "properties": {
          "default": {
            "type": "string",
            "description": "Which entry answers a request that names no model."
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            }
          }
        }
      },
      "OptionProbability": {
        "type": "object",
        "required": [
          "option",
          "probability"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Question": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QuestionKind"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        ],
        "description": "One question, identified so its answer can be found in the response map. It names exactly one\nprimitive."
      },
      "QuestionKind": {
        "oneOf": [
          {
            "type": "object",
            "description": "How likely the answer is yes.",
            "required": [
              "noul"
            ],
            "properties": {
              "noul": {
                "type": "string",
                "description": "How likely the answer is yes."
              }
            }
          },
          {
            "type": "object",
            "description": "One of up to [`MAX_OPTIONS`] options.",
            "required": [
              "choice"
            ],
            "properties": {
              "choice": {
                "$ref": "#/components/schemas/ChoiceSpec",
                "description": "One of up to [`MAX_OPTIONS`] options."
              }
            }
          },
          {
            "type": "object",
            "description": "A position on a rubric of [`MIN_LEVELS`]..=[`MAX_LEVELS`] levels.",
            "required": [
              "score"
            ],
            "properties": {
              "score": {
                "$ref": "#/components/schemas/ScoreSpec",
                "description": "A position on a rubric of [`MIN_LEVELS`]..=[`MAX_LEVELS`] levels."
              }
            }
          }
        ],
        "description": "The three primitives. Externally tagged, so the wire form is `{\"id\": .., \"noul\": ..}`."
      },
      "ScoreSpec": {
        "type": "object",
        "required": [
          "levels"
        ],
        "properties": {
          "levels": {
            "$ref": "#/components/schemas/LevelSpec"
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "SystemOneRequest": {
        "type": "object",
        "description": "A shared state plus the questions to ask about it.\n\nUnknown fields are refused rather than ignored: a misspelt `calibraton` would otherwise\nbe dropped without a word, and the answers would come back uncalibrated.",
        "required": [
          "state",
          "questions"
        ],
        "properties": {
          "calibration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Calibration",
                "description": "Overrides the calibration applied to label logits."
              }
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model name or configured alias. Falls back to the server's default when absent."
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "description": "The questions. Ids must be unique within a request."
          },
          "state": {
            "type": "string",
            "description": "The context every question is asked against."
          }
        },
        "additionalProperties": false
      },
      "SystemOneResponse": {
        "type": "object",
        "required": [
          "answers",
          "model",
          "usage",
          "timing_ms"
        ],
        "properties": {
          "answers": {
            "type": "object",
            "description": "Answers keyed by the question id they were asked under.",
            "additionalProperties": {
              "$ref": "#/components/schemas/Answer"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "model": {
            "type": "string",
            "description": "The model actually used, after alias resolution."
          },
          "timing_ms": {
            "$ref": "#/components/schemas/Timing"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Timing": {
        "type": "object",
        "required": [
          "total"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "input_tokens",
          "questions"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "format": "int32",
            "description": "Prompt tokens summed over every question in the request.",
            "minimum": 0
          },
          "questions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "cerno",
      "description": "System-one decisions over local models"
    }
  ]
}
